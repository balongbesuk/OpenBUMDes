{
  "name": "openbumdes",
  "version": "1.5.0",
  "private": true,
  "description": "Sistem Informasi Akuntansi dan Laporan Keuangan BUMDes Standar Kepmendes 136/2022",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:setup": "prisma db push && prisma db seed && npm run db:seed-templates",
    "db:seed": "prisma db seed",
    "test": "node tests/self-check.mjs",
    "db:seed-templates": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed_templates.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^7.1.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
