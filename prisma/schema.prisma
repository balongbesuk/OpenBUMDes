datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("OPERATOR")
  createdAt    DateTime @default(now())
}

model LedgerAccount {
  code      String   @id
  name      String
  type      String
  normal    String
  createdAt DateTime @default(now())
}

model TransactionTemplate {
  id            String   @id @default(uuid())
  category      String
  name          String
  targetAccount String
  cashAccount   String
  cashFlowGroup String?
  description   String?
  createdAt     DateTime @default(now())
}

model JournalEntry {
  id                 String        @id @default(uuid())
  proofNumber        String        @unique
  proofType          String
  date               DateTime      @default(now())
  description        String
  payeeOrPayer       String
  unitName           String?
  note               String?
  attachmentUrl      String?
  verificationStatus String        @default("DRAFT")
  createdAt          DateTime      @default(now())
  lines              JournalLine[]
  @@index([proofType])
  @@index([date])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode    String
  type           String
  amount         Float
  cashFlowGroup  String?
  @@index([journalEntryId])
  @@index([accountCode])
}

model Setting {
  key   String @id
  value String
}

model AnnualClosing {
  id                String   @id @default(uuid())
  year              Int      @unique
  closedAt          DateTime @default(now())
  closedBy          String   @default("Pengurus BUMDes")
  totalRevenue      Float    @default(0)
  totalExpense      Float    @default(0)
  netProfit         Float    @default(0)
  padesPercent      Float    @default(40)
  padesAmount       Float    @default(0)
  cadanganPercent   Float    @default(20)
  cadanganAmount    Float    @default(0)
  pengurusPercent   Float    @default(20)
  pengurusAmount    Float    @default(0)
  sosialPercent     Float    @default(10)
  sosialAmount      Float    @default(0)
  pendidikanPercent Float    @default(10)
  pendidikanAmount  Float    @default(0)
  journalEntryId    String?
  snapshotData      String
  isLocked          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
}

model OpeningBalance {
  id          String   @id @default(uuid())
  year        Int
  accountCode String
  amount      Float
  type        String
  createdAt   DateTime @default(now())

  @@unique([year, accountCode])
}

model InventoryItem {
  id          String              @id @default(uuid())
  code        String              @unique
  name        String
  unit        String              @default("Pcs")
  category    String?             @default("Barang Dagangan")
  initialQty  Float               @default(0)
  initialCost Float               @default(0)
  currentQty  Float               @default(0)
  minStock    Float               @default(5)
  accountCode String              @default("1.1.05.01")
  notes       String?
  createdAt   DateTime            @default(now())
  movements   InventoryMovement[]
}

model InventoryMovement {
  id             String        @id @default(uuid())
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  date           DateTime      @default(now())
  type           String        // "IN", "OUT", "ADJUST"
  qty            Float
  costPerUnit    Float         @default(0)
  totalCost      Float         @default(0)
  referenceProof String?
  description    String
  createdAt      DateTime      @default(now())

  @@index([itemId])
  @@index([date])
}

model FixedAsset {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  category         String   @default("Peralatan & Mesin")
  acquisitionDate  DateTime
  acquisitionCost  Float
  usefulLifeYears  Int      @default(4)
  salvageValue     Float    @default(0)
  assetAccountCode String   @default("1.2.01.01")
  deprAccountCode  String   @default("1.2.02.01")
  expAccountCode   String   @default("6.1.05.01")
  location         String?  @default("Kantor BUMDes")
  condition        String   @default("BAIK")
  notes            String?
  createdAt        DateTime @default(now())
}

model LoanMember {
  id               String            @id @default(uuid())
  memberNo         String            @unique
  name             String
  nik              String?
  phone            String?
  address          String?
  groupName        String?
  memberType       String            @default("INDIVIDU") // "INDIVIDU", "KELOMPOK"
  joinDate         DateTime          @default(now())
  status           String            @default("ACTIVE") // "ACTIVE", "INACTIVE"
  simpananPokok    Float             @default(0)
  simpananWajib    Float             @default(0)
  simpananSukarela Float             @default(0)
  totalPinjaman    Float             @default(0)
  sisaPinjaman     Float             @default(0)
  bungaPersen      Float             @default(1.5)
  jangkaWaktuBulan Int               @default(12)
  statusPinjaman   String            @default("LUNAS") // "LUNAS", "BERJALAN", "MACET"
  notes            String?
  createdAt        DateTime          @default(now())
  transactions     LoanTransaction[]

  @@index([status])
  @@index([memberType])
}

model LoanTransaction {
  id              String      @id @default(uuid())
  memberId        String
  member          LoanMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date            DateTime    @default(now())
  proofNumber     String?
  type            String      // "SIMPANAN_POKOK", "SIMPANAN_WAJIB", "SIMPANAN_SUKARELA", "TARIK_SIMPANAN", "PENCAIRAN_PINJAMAN", "ANGSURAN_POKOK", "ANGSURAN_BUNGA"
  amount          Float
  principalAmount Float       @default(0)
  interestAmount  Float       @default(0)
  description     String
  journalEntryId  String?
  createdAt       DateTime    @default(now())

  @@index([memberId])
  @@index([date])
  @@index([type])
}