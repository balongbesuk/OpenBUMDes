datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("OPERATOR")
  createdAt    DateTime @default(now())
}

model LedgerAccount {
  code      String   @id
  name      String
  type      String
  normal    String
  createdAt DateTime @default(now())
}

model TransactionTemplate {
  id            String   @id @default(uuid())
  category      String
  name          String
  targetAccount String
  cashAccount   String
  cashFlowGroup String?
  description   String?
  createdAt     DateTime @default(now())
}

model JournalEntry {
  id                 String        @id @default(uuid())
  proofNumber        String        @unique
  proofType          String
  date               DateTime      @default(now())
  description        String
  payeeOrPayer       String
  unitName           String?
  note               String?
  attachmentUrl      String?
  verificationStatus String        @default("DRAFT")
  createdAt          DateTime      @default(now())
  lines              JournalLine[]
  @@index([proofType])
  @@index([date])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode    String
  type           String
  amount         Float
  cashFlowGroup  String?
  @@index([journalEntryId])
  @@index([accountCode])
}

model Setting {
  key   String @id
  value String
}

model AnnualClosing {
  id                String   @id @default(uuid())
  year              Int      @unique
  closedAt          DateTime @default(now())
  closedBy          String   @default("Pengurus BUMDes")
  totalRevenue      Float    @default(0)
  totalExpense      Float    @default(0)
  netProfit         Float    @default(0)
  padesPercent      Float    @default(40)
  padesAmount       Float    @default(0)
  cadanganPercent   Float    @default(20)
  cadanganAmount    Float    @default(0)
  pengurusPercent   Float    @default(20)
  pengurusAmount    Float    @default(0)
  sosialPercent     Float    @default(10)
  sosialAmount      Float    @default(0)
  pendidikanPercent Float    @default(10)
  pendidikanAmount  Float    @default(0)
  journalEntryId    String?
  snapshotData      String
  isLocked          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
}

model OpeningBalance {
  id          String   @id @default(uuid())
  year        Int
  accountCode String
  amount      Float
  type        String
  createdAt   DateTime @default(now())

  @@unique([year, accountCode])
}